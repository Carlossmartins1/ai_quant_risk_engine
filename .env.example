# =============================================================================
# AI Quant Risk Engine — plantilla de variables de entorno
# Copia este fichero a .env y rellena los valores. NUNCA subas .env a git.
# Las variables comentadas son opcionales: el código aplica el valor indicado
# por defecto si no se definen.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (database/connection.py, docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=risk_engine
POSTGRES_USER=risk_admin
# Obligatoria para docker compose. Genera una con: openssl rand -hex 24
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=prefer

# Pool y timeouts de sesión
# DB_APPLICATION_NAME=risk_engine
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_POOL_TIMEOUT_S=5.0
# DB_CONNECT_TIMEOUT_S=5
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_LOCK_TIMEOUT_MS=2000
# DB_IDLE_IN_TX_TIMEOUT_MS=30000

# Overrides solo para tests de integración (tests/conftest.py usa TEST_<VAR>)
# TEST_POSTGRES_HOST=127.0.0.1
# TEST_POSTGRES_PORT=5432
# TEST_POSTGRES_USER=risk_admin
# TEST_POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Hyperliquid (exchange_connector/)
# -----------------------------------------------------------------------------
# testnet | mainnet. Mainnet exige además HL_ALLOW_MAINNET=true.
HL_NETWORK=testnet
HL_ALLOW_MAINNET=false

# Define HL_SECRET_KEY (trading) o HL_ACCOUNT_ADDRESS (solo lectura).
# HL_SECRET_KEY: clave privada hex de 32 bytes (con o sin 0x). Usa una wallet de API dedicada.
HL_SECRET_KEY=
HL_ACCOUNT_ADDRESS=
# HL_VAULT_ADDRESS=

# Guardarraíles
# HL_ALLOWED_COINS=BTC,ETH
# HL_MAX_ORDER_NOTIONAL_USD=250000
# HL_DEFAULT_SLIPPAGE=0.01
# HL_REQUEST_TIMEOUT_S=10.0
# HL_RATE_LIMIT_PER_MIN=600

# -----------------------------------------------------------------------------
# Agentes IA (ai_agents/trader_agents.py)
# Sin OPENAI_API_KEY los agentes funcionan con reglas, sin LLM.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Dashboard (dashboard/app.py)
# -----------------------------------------------------------------------------
# Genera una con: openssl rand -base64 24
DASHBOARD_ADMIN_PASSWORD=change_me
# DASHBOARD_OPERATOR_NAME=operator
# DASHBOARD_DB_POOL_MAX=5
# DASHBOARD_REFRESH_S=3
# DASHBOARD_PORT=8501

# -----------------------------------------------------------------------------
# Logging (common/logging_config.py)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# json | console. Vacío = json si stdout no es una TTY.
# LOG_FORMAT=
# LOG_FILE=/var/log/risk-engine/engine.log
# LOG_FILE_MAX_BYTES=20971520
# LOG_FILE_BACKUPS=50

# -----------------------------------------------------------------------------
# Despliegue / healthcheck (deployment/scripts/)
# -----------------------------------------------------------------------------
# SERVICE_ROLE=orchestrator
# HEALTH_MAX_HEARTBEAT_AGE_S=30

# -----------------------------------------------------------------------------
# Archivado de logs en S3 (deployment/scripts/upload_logs_s3.py)
# LOG_ARCHIVE_BUCKET es obligatoria solo para el servicio shipper.
# -----------------------------------------------------------------------------
# LOG_ARCHIVE_BUCKET=
# LOG_ARCHIVE_PREFIX=risk-engine
# LOG_ARCHIVE_KMS_KEY_ID=
# LOG_DIR=/var/log/risk-engine
# LOG_SERVICE_NAME=risk-engine
# LOG_HOST_NAME=
# LOG_SHIP_INTERVAL_S=300
# AUDIT_EXPORT_ENABLED=false
# AWS_REGION=eu-west-1
# S3_ENDPOINT_URL=
