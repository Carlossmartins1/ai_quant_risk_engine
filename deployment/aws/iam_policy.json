{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArchiveWriteOnlyUnderPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::my-risk-engine-archive/risk-engine/prod/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "aws:kms"
        }
      }
    },
    {
      "Sid": "ArchiveReadbackForVerification",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::my-risk-engine-archive/risk-engine/prod/*"
    },
    {
      "Sid": "ArchiveListPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-risk-engine-archive",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "risk-engine/prod/*"
          ]
        }
      }
    },
    {
      "Sid": "KmsForArchive",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:eu-west-1:123456789012:key/<risk-engine-logs-key-id>"
    },
    {
      "Sid": "ReadRuntimeSecrets",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:eu-west-1:123456789012:parameter/risk-engine/prod*"
    },
    {
      "Sid": "PullImages",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "*"
    }
  ]
}
