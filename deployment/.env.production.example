# =============================================================================
#  Variables de entorno de PRODUCCIÓN (plantilla).
#  NO subir el fichero real a git. En EC2, aws/user_data.sh lo genera desde AWS SSM Parameter
#  Store (SecureString) para que ningún secreto viva en el repositorio ni en la imagen.
#  Los valores <SSM:...> son los parámetros de los que se leerán.
# =============================================================================

# --- Imagen ------------------------------------------------------------------
REGISTRY=123456789012.dkr.ecr.eu-west-1.amazonaws.com
IMAGE_TAG=latest

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=risk_engine
POSTGRES_USER=risk_admin
POSTGRES_PASSWORD=<SSM:/risk-engine/prod/postgres_password>
POSTGRES_SSLMODE=disable          # tráfico en la red interna de Docker; usa 'require' con RDS
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_MAX_BYTES=20971520
LOG_FILE_BACKUPS=50

# --- Orquestador -------------------------------------------------------------
# Servicio continuo; el Cisne Negro se dispara desde el dashboard. Añade --live para precios reales.
ORCHESTRATOR_ARGS=--tick 1.0 --whale-bias LONG
OPENAI_API_KEY=<SSM:/risk-engine/prod/openai_api_key>
OPENAI_MODEL=gpt-4o-mini
HL_NETWORK=testnet
HL_ALLOW_MAINNET=false
HL_ACCOUNT_ADDRESS=
HL_SECRET_KEY=<SSM:/risk-engine/prod/hl_api_wallet_key>
HEALTH_MAX_HEARTBEAT_AGE_S=30

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_S=3
DASHBOARD_DB_POOL_MAX=5
DASHBOARD_ADMIN_PASSWORD=<SSM:/risk-engine/prod/dashboard_admin_password>
DASHBOARD_OPERATOR_NAME=risk-operator

# --- Archivado S3 ------------------------------------------------------------
AWS_REGION=eu-west-1
LOG_ARCHIVE_BUCKET=my-risk-engine-archive
LOG_ARCHIVE_PREFIX=risk-engine/prod
LOG_ARCHIVE_KMS_KEY_ID=arn:aws:kms:eu-west-1:123456789012:alias/risk-engine-logs
LOG_SHIP_INTERVAL_S=300
AUDIT_EXPORT_ENABLED=true
LOG_SERVICE_NAME=risk-engine
